# Salin menjadi .env lalu isi. File .env TIDAK BOLEH di-commit.

# Token bot dari Discord Developer Portal.
# (Fallback sementara: bot_token di appsettings.json)
DISCORD_TOKEN=

# Kunci rahasia session Flask. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Web panel (default hanya bisa diakses dari komputer ini)
WEB_HOST=127.0.0.1
WEB_PORT=8080

# true hanya jika panel diakses lewat HTTPS
SESSION_COOKIE_SECURE=false

# Path relatif diresolusi terhadap folder proyek
DATABASE_URL=sqlite:///radsoftbot.db
